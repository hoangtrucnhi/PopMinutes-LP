<!-- PDF Modal -->
<div id="pdfModal" class="modal-overlay hidden" style="position:fixed; inset:0; background:rgba(0,0,0,0.5); display:flex; align-items:center; justify-content:center; z-index:9999;">
    <div class="media-modal-content" style="width:90%; max-width:900px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
            <h3 style="font-size:1.2rem; font-weight:800;">Xem Kết quả (PDF)</h3>
            <button onclick="closePdfModal()" style="background:none; border:none; cursor:pointer; color:#64748b;">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:24px; height:24px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        <iframe src="https://docs.google.com/document/d/1N9PJ8FxBhkOYXHG85ryXwCxdx0PjboBZFjSqGrLdcDI/preview" style="width:100%; height:70vh; border:none; border-radius:1rem;"></iframe>
    </div>
</div>
<script>
    // ==========================================
    // 1. CẤU HÌNH LINK GAS CỦA CẬU
    // ==========================================
    // Thay thế link dưới đây bằng link Web App URL từ Google Apps Script của cậu
    const GAS_URL = "https://script.google.com/macros/s/AKfycbxrYkvMg1JxGCzuPzdpUaBYIrqZu6DyX2Qh0IXV49OYhAaCb6NHBY9BZFmdBBxLe65i/exec"; 

    // ==========================================
    // 2. HIỆU ỨNG CUỘN TRANG (SCROLL REVEAL)
    // ==========================================
    document.addEventListener("DOMContentLoaded", function() {
        const reveals = document.querySelectorAll(".reveal");
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("active");
                }
            });
        }, { threshold: 0.15 });
        reveals.forEach(reveal => observer.observe(reveal));
    });

    // ==========================================
    // 3. CÁC HÀM ĐIỀU HƯỚNG & CUỘN
    // ==========================================
    function scrollToForm() {
        document.getElementById("ctaSection").scrollIntoView({ behavior: "smooth" });
    }

    function scrollToDemo() {
        openAudioModal(); // Mở modal audio khi bấm XEM DEMO
    }

    // ==========================================
    // 4. CÁC HÀM MỞ/ĐÓNG MODAL
    // ==========================================
    function openPricingModal(planName) {
        const modal = document.getElementById("pricingModal");
        if (modal) {
            modal.classList.remove("hidden");
            const select = document.getElementById("pricingPackage");
            if (select) select.value = planName; // Tự động chọn gói
        }
    }

    function closePricingModal() {
        document.getElementById("pricingModal")?.classList.add("hidden");
    }

    function openAudioModal() {
        document.getElementById("audioModal")?.classList.remove("hidden");
    }

    function closeAudioModal() {
        document.getElementById("audioModal")?.classList.add("hidden");
    }

    function openPdfModal() {
        document.getElementById("pdfModal")?.classList.remove("hidden");
    }

    function closePdfModal() {
        document.getElementById("pdfModal")?.classList.add("hidden");
    }

    function showSuccessModal(title, message) {
        const modal = document.getElementById("successModal");
        if (modal) {
            document.getElementById("modalTitle").innerText = title;
            document.getElementById("modalMessage").innerText = message;
            modal.classList.remove("hidden");
        }
    }

    document.getElementById("modalCloseBtn")?.addEventListener("click", () => {
        document.getElementById("successModal")?.classList.add("hidden");
    });

    // Đóng modal khi click ra ngoài vùng nội dung
    document.querySelectorAll('.modal-overlay').forEach(overlay => {
        overlay.addEventListener('click', function(e) {
            if (e.target === this) {
                this.classList.add('hidden');
            }
        });
    });

    // ==========================================
    // 5. XỬ LÝ GỬI FORM ĐẾN GOOGLE APPS SCRIPT
    // ==========================================
    async function submitFormToGAS(formId, buttonId, sourceName, successMessage) {
        const form = document.getElementById(formId);
        const btn = document.getElementById(buttonId);
        
        if (!form || !btn) return;

        form.addEventListener("submit", async function(e) {
            e.preventDefault(); // Chặn reload trang
            
            // Kiểm tra validation của HTML5
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            // Đổi trạng thái nút thành Loading
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner"></span> Đang gửi...';

            // Thu thập dữ liệu form và thêm source
            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());
            data.source = sourceName; // Gán source để GAS phân loại

            // Xử lý riêng cho form Pricing (map các trường)
            if (formId === "pricingForm") {
                data.note = `Gói: ${data.package || ''} | Công ty: ${data.company || ''} | Số Sales: ${data.scale || ''}`;
            }

            try {
                // Gửi dữ liệu đến GAS (Dùng text/plain để tránh lỗi CORS preflight)
                const response = await fetch(GAS_URL, {
                    method: "POST",
                    body: JSON.stringify(data),
                    headers: { "Content-Type": "text/plain;charset=utf-8" }
                });

                const result = await response.json();
                
                if (result.result === "success" || response.ok) {
                    showSuccessModal("Thành công", successMessage);
                    form.reset(); // Xóa trắng form
                } else {
                    showSuccessModal("Lỗi", result.message || "Có lỗi xảy ra, vui lòng thử lại.");
                }
            } catch (error) {
                console.error("Lỗi gửi form:", error);
                showSuccessModal("Lỗi kết nối", "Không thể kết nối đến máy chủ. Vui lòng kiểm tra mạng.");
            } finally {
                // Khôi phục trạng thái nút
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        });
    }

    // Kích hoạt các form
    // Form CTA (Source: "CTA")
    submitFormToGAS("ctaForm", "ctaSubmitBtn", "CTA", "Cảm ơn bạn! Đội ngũ PopHubly sẽ liên hệ trong thời gian sớm nhất.");
    
    // Form Newsletter (Source: "NEWSLETTER")
    submitFormToGAS("newsletterForm", "newsletterSubmitBtn", "NEWSLETTER", "Đăng ký nhận tin thành công!");
    
    // Form Pricing (Source: "PRICING")
    submitFormToGAS("pricingForm", "pricingSubmitBtn", "PRICING", "Đăng ký gói dịch vụ thành công! Chúng tôi sẽ liên hệ để xác nhận.");
</script>
</body>
</html>
