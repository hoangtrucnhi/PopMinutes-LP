    <title>PopMinutes — Sales Meeting Intelligence</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --popblue: #4a66a0;
            --popblue-deep: #364f82;
            --popdark: #0f172a;
            --accent-glow: rgba(74, 102, 160, 0.25);
        }
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #fff !important;
            color: #1e293b !important;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        ::selection { background: var(--popblue); color: #fff; }
        .title-bold { font-weight: 900; letter-spacing: -0.045em; line-height: 1.5; }
        .text-gradient {
            background: linear-gradient(135deg, #0f172a 0%, #4a66a0 65%, #5b7cc5 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
            color: #4a66a0;
        }
        .text-gradient-light {
            background: linear-gradient(135deg, #ffffff 0%, #c4d1f0 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
            color: #c4d1f0;
        }
        .section-white { background: #ffffff !important; }
        .section-light {
            background: #fafbfc !important;
            border-top: 1px solid #edf0f5; border-bottom: 1px solid #edf0f5;
        }
        .section-dark {
            background: #0b1120 !important;
            color: white !important;
        }
        .reveal {
            opacity: 0; transform: translateY(48px);
            transition: opacity 0.85s cubic-bezier(0.16, 0.67, 0.29, 0.99), transform 0.85s cubic-bezier(0.16, 0.67, 0.29, 0.99);
        }
        .reveal.active { opacity: 1; transform: translateY(0); }
        .reveal-delay-1 { transition-delay: 0.12s; }
        .reveal-delay-2 { transition-delay: 0.24s; }
        .reveal-delay-3 { transition-delay: 0.36s; }
        .step-trigger {
            opacity: 0.45; transition: all 0.45s cubic-bezier(0.16, 0.67, 0.29, 0.99);
            border-left: 3px solid transparent; padding-left: 2rem; cursor: pointer; border-radius: 0 8px 8px 0;
        }
        .step-trigger.active {
            opacity: 1; border-left-color: var(--popblue);
            background: linear-gradient(90deg, rgba(74,102,160,0.06) 0%, transparent 100%); transform: translateX(8px);
        }
        .step-trigger:hover { opacity: 0.75; }
        .btn-main {
            background: var(--popblue); color: white; padding: 1.2rem 2.6rem; border-radius: 100px;
            font-weight: 800; font-size: 0.95rem; letter-spacing: 0.02em;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1.2);
            display: inline-flex; align-items: center; gap: 10px;
            box-shadow: 0 8px 28px rgba(74,102,160,0.18); position: relative; overflow: hidden;
        }
        .btn-main::after {
            content: ''; position: absolute; inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.2) 0%, transparent 60%);
            border-radius: 100px; opacity: 0; transition: opacity 0.3s;
        }
        .btn-main:hover {
            transform: translateY(-3px) scale(1.03); box-shadow: 0 22px 44px rgba(74,102,160,0.32);
            background: var(--popblue-deep);
        }
        .btn-main:hover::after { opacity: 1; }
        .btn-main:active { transform: translateY(0) scale(0.98); transition: all 0.1s; }
        .btn-main:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none !important;
            box-shadow: none !important;
        }
        .btn-main .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255,255,255,0.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin-right: 6px;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .btn-outline {
            display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 0.95rem;
            letter-spacing: 0.02em; padding: 1.2rem 2.6rem; border-radius: 100px;
            border: 2px solid #e2e8f0; color: #1e293b; transition: all 0.3s;
        }
        .btn-outline:hover { border-color: var(--popblue); color: var(--popblue); background: rgba(74,102,160,0.03); }
        .wide-container { max-width: 1400px; margin: 0 auto; padding: 0 40px; }
        @media (max-width: 768px) {
            .wide-container { padding: 0 20px; }
            .title-bold { letter-spacing: -0.03em; }
            .nav-mini {
                background-color: #fff !important;
                backdrop-filter: none !important;
            }
            .section-dark { background: #1e293b !important; }
        }
        @keyframes floatCard { 0%,100% { transform: translateY(0px); } 50% { transform: translateY(-8px); } }
        .float-anim { animation: floatCard 5.5s ease-in-out infinite; }
        .bg-noise { background-image: radial-gradient(rgba(0,0,0,0.03) 1px, transparent 1px); background-size: 28px 28px; }
        .glow-orb {
            position: absolute; border-radius: 50%; filter: blur(120px); opacity: 0.22; pointer-events: none; z-index: 0;
        }
        .input-elegant {
            width: 100%; padding: 1.1rem 1.5rem;
            background: #ffffff;
            border: 1.5px solid #e2e8f0;
            border-radius: 100px;
            outline: none; font-weight: 500; font-size: 0.95rem;
            transition: all 0.3s; color: #1e293b;
        }
        .input-elegant:focus {
            border-color: var(--popblue);
            box-shadow: 0 0 0 4px rgba(74,102,160,0.06);
        }
        .input-elegant::placeholder { color: #94a3b8; font-weight: 400; }
        .input-elegant:invalid:not(:placeholder-shown) {
            border-color: #d1d5db;
        }
        .input-elegant:valid:not(:placeholder-shown) {
            border-color: var(--popblue);
        }
        .input-elegant:focus:invalid:not(:placeholder-shown) {
            border-color: var(--popblue);
        }
        .input-elegant::-webkit-validation-bubble-message {
            display: none;
        }
        textarea.input-elegant {
            border-radius: 24px;
            resize: vertical;
        }
        /* ===== CHECKBOX - CĂN CHỈNH ĐỀU VỚI LABEL, KHÔNG TÔ NỀN ===== */
        .consent-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 6px;
        }
        .consent-checkbox {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
            margin: 0;
            padding: 0;
            cursor: pointer;
            border: 2px solid #cbd5e1 !important;
            border-radius: 5px;
            background-color: #ffffff;
            transition: all 0.2s ease;
            appearance: none;
            -webkit-appearance: none;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            color: var(--popblue);
            font-size: 16px;
            font-weight: 700;
        }
        .consent-checkbox:checked {
            background-color: #ffffff; /* Không tô nền xanh */
            border-color: var(--popblue) !important;
        }
        .consent-checkbox:checked::before {
            content: "✓";
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
            color: var(--popblue);
        }
        .consent-checkbox:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(74, 102, 160, 0.15);
        }
        .consent-checkbox:invalid {
            border-color: #cbd5e1 !important;
        }
        .consent-checkbox:invalid:checked {
            border-color: var(--popblue) !important;
        }
        .consent-label {
            font-size: 0.9rem;
            color: #475569;
            font-weight: 500;
            line-height: 1.5;
            cursor: pointer;
            margin: 0;
            padding: 0;
        }
        .consent-link {
            color: var(--popblue);
            font-weight: 700;
            text-decoration: underline;
            text-underline-offset: 2px;
            transition: color 0.2s;
        }
        .consent-link:hover {
            color: var(--popblue-deep);
        }
        #step-preview { transition: opacity 0.35s ease, transform 0.35s ease; }
        .label-sm { font-size: 0.8rem; letter-spacing: 0.18em; }
        .label-md { font-size: 0.85rem; letter-spacing: 0.2em; }
        .nav-mini a { font-weight: 500; font-size: 1.125rem; letter-spacing: 0.05em; text-transform: uppercase; }
        .nav-mini { gap: 2rem; }
        .modal-overlay { transition: opacity 0.3s ease; }
        .modal-overlay.hidden { opacity: 0; pointer-events: none; }
        .modal-content { transition: opacity 0.3s ease, transform 0.3s ease; opacity: 0; transform: scale(0.9); }
        .modal-overlay:not(.hidden) .modal-content { opacity: 1; transform: scale(1); }
        .media-modal-content {
            max-width: 90vw;
            width: 600px;
            background: white;
            border-radius: 2rem;
            padding: 2rem;
            box-shadow: 0 30px 60px rgba(0,0,0,0.3);
            transition: inherit;
            opacity: 0;
            transform: scale(0.9);
        }
        .modal-overlay:not(.hidden) .media-modal-content {
            opacity: 1;
            transform: scale(1);
        }
        .media-modal-content iframe {
            width: 100%;
            height: 70vh;
            max-height: 600px;
            border: none;
            border-radius: 1rem;
        }
        .toggle-switch {
            position: relative;
            display: inline-flex;
            align-items: center;
            cursor: pointer;
            gap: 10px;
        }
        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }
        .slider {
            position: relative;
            display: inline-block;
            width: 48px;
            height: 24px;
            background-color: #cbd5e1;
            border-radius: 34px;
            transition: 0.3s;
        }
        .slider:before {
            position: absolute;
            content: "";
            height: 20px;
            width: 20px;
            left: 2px;
            bottom: 2px;
            background-color: white;
            border-radius: 50%;
            transition: 0.3s;
        }
        input:checked + .slider {
            background-color: var(--popblue);
        }
        input:checked + .slider:before {
            transform: translateX(24px);
        }
        .toggle-label {
            font-weight: 800;
            font-size: 0.8rem;
            letter-spacing: 0.02em;
            color: #ffffff;
        }
        .inline-flex {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .free-badge {
            font-weight: 700;
            font-size: 1.1rem;
            color: #0f172a;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .free-badge svg {
            flex-shrink: 0;
        }
    </style>
</head>
